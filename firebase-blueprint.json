{
  "entities": {
    "Video": {
      "title": "Video",
      "description": "Modul video pelatihan resmi yang diunggah administrator",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "durationSeconds": { "type": "number" },
        "durationFormatted": { "type": "string" },
        "thumbnail": { "type": "string" },
        "fileSizeMb": { "type": "number" },
        "videoUrl": { "type": "string" },
        "uploadDate": { "type": "string" },
        "viewsCount": { "type": "number" },
        "uploadedBy": { "type": "string" },
        "checksum": { "type": "string" }
      },
      "required": ["id", "title", "durationSeconds", "videoUrl"]
    },
    "Product": {
      "title": "Product",
      "description": "Katalog peralatan praktikum dan kit sertifikasi",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "originalPrice": { "type": "number" },
        "discountPercentage": { "type": "number" },
        "finalPrice": { "type": "number" },
        "quantity": { "type": "number" },
        "description": { "type": "string" },
        "image": { "type": "string" },
        "weightKg": { "type": "number" },
        "sku": { "type": "string" }
      },
      "required": ["id", "name", "originalPrice", "finalPrice"]
    },
    "User": {
      "title": "User",
      "description": "Data akun administrator tunggal atau peserta 6-digit",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "trainee"] },
        "password": { "type": "string" },
        "registeredAt": { "type": "string" },
        "avatar": { "type": "string" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Order": {
      "title": "Order",
      "description": "Transaksi pemesanan barang dan pelacakan resi ekspedisi",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "traineeId": { "type": "string" },
        "traineeName": { "type": "string" },
        "traineeEmail": { "type": "string" },
        "items": { "type": "string" },
        "subtotal": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "grandTotal": { "type": "number" },
        "status": { "type": "string" },
        "trackingNumber": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "traineeId", "grandTotal", "status"]
    },
    "SystemState": {
      "title": "SystemState",
      "description": "Pengaturan terpusat aplikasi, pembayaran, dan logistik",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "appSettings": { "type": "string" },
        "paymentSettings": { "type": "string" },
        "deliveryServices": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id"]
    }
  },
  "firestore": {
    "/videos/{videoId}": {
      "schema": { "$ref": "Video" },
      "description": "Koleksi video pelatihan sinkron untuk seluruh perangkat"
    },
    "/products/{productId}": {
      "schema": { "$ref": "Product" },
      "description": "Koleksi katalog produk peralatan praktikum"
    },
    "/users/{userId}": {
      "schema": { "$ref": "User" },
      "description": "Akun administrator dan peserta terdaftar"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "Order" },
      "description": "Data transaksi pesanan dan logistik"
    },
    "/system/{settingId}": {
      "schema": { "$ref": "SystemState" },
      "description": "Pengaturan sentral aplikasi dan gerbang pembayaran"
    }
  }
}
